{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "aps-framework": {
      "type": "remote",
      "url": "https://aps-mcp-server.azurewebsites.net/mcp?discovery=APS-Framework:aps-framework&exclude=APS-Framework/.github",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    }
  }
}