{
  "inputs": [
    {
      "type": "promptString",
      "id": "github-token",
      "description": "Token de GitHub (gh auth token)",
      "password": true
    }
  ],
  "servers": {
    "aps-framework": {
      "type": "http",
      "url": "https://aps-mcp-server.azurewebsites.net/mcp?discovery=APS-Framework:aps-framework&exclude=APS-Framework/.github",
      "headers": {
        "Authorization": "Bearer ${input:github-token}"
      }
    },
    "aisquare-playwright": {
      "command": "npx",
      "args": [
        "aisquare-playwright-mcp@latest"
      ],
      "type": "stdio"
    }
  }
}